    def channel_count(value, fallback="--"):
        if value is None:
            return fallback
        try:
            number = int(float(value))
        except (TypeError, ValueError):
            return fallback
        if number >= 1_000_000:
            return f"{number / 1_000_000:.1f}M"
        if number >= 1_000:
            return f"{number / 1_000:.1f}K"
        return f"{number:,}"

