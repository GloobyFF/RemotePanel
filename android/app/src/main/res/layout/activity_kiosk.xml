<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rp_bg"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="52dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/prevBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="上一页"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/rp_accent" />

        <TextView
            android:id="@+id/titleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rp_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/rp_ok"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="@string/live"
            android:textColor="@color/rp_black"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/indexLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/rp_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/clockLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/rp_text_dim"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/rp_accent" />

        <ImageButton
            android:id="@+id/nextBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="下一页"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/rp_accent" />
    </LinearLayout>

    <View
        android:id="@+id/progressTrack"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="bottom"
        android:background="#38FFFFFF" />

    <View
        android:id="@+id/progressFill"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_gravity="bottom|start"
        android:background="@color/rp_accent" />

    <View
        android:id="@+id/edgeLeft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/edgeRight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/chromePeek"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:visibility="gone" />
</FrameLayout>
